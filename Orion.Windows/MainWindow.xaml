<Window
    x:Class="Orion.Windows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="{Binding Title}"
    Icon="pack://application:,,,/Assets/OrionRE.ico"
    Width="1440"
    Height="960"
    MinWidth="1080"
    MinHeight="700"
    Background="{StaticResource OrionWindowBrush}"
    Foreground="{StaticResource OrionTextBrush}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <Style x:Key="CardStyle" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="{StaticResource OrionSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource OrionBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="16" />
        </Style>

        <Style x:Key="CategoryItemStyle" TargetType="{x:Type ListBoxItem}">
            <Setter Property="Foreground" Value="{StaticResource OrionSubtleTextBrush}" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                        <Border x:Name="ItemBorder" Background="Transparent" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource OrionHoverBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource OrionTextBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource OrionAccentSoftBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource OrionAccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CatalogItemStyle" TargetType="{x:Type ListBoxItem}">
            <Setter Property="Foreground" Value="{StaticResource OrionTextBrush}" />
            <Setter Property="Padding" Value="14" />
            <Setter Property="Margin" Value="0,0,10,10" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                        <Border x:Name="ItemBorder"
                                Background="{StaticResource OrionSurfaceBrush}"
                                BorderBrush="{StaticResource OrionBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="14"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource OrionHoverBrush}" />
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{StaticResource OrionBorderStrongBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource OrionAccentSoftBrush}" />
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{StaticResource OrionAccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="QuietButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Foreground" Value="{StaticResource OrionTextBrush}" />
            <Setter Property="Background" Value="{StaticResource OrionSurfaceRaisedBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource OrionBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource OrionHoverBrush}" />
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{StaticResource OrionBorderStrongBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.55" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,22">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="380" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <Image Width="46" Height="46" Source="/Assets/OrionRE.png" />
                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="ORION-RE" FontSize="13" FontWeight="Bold" Foreground="{StaticResource OrionAccentBrush}" />
                    <TextBlock Text="A better desktop starts here" FontSize="19" FontWeight="SemiBold" Margin="0,2,0,0" />
                </StackPanel>
            </StackPanel>

            <Grid Grid.Column="1" Height="44" VerticalAlignment="Center">
                <Border Background="{StaticResource OrionSurfaceBrush}" BorderBrush="{StaticResource OrionBorderBrush}" BorderThickness="1" CornerRadius="11" />
                <Grid Margin="14,0,8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Search" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource OrionAccentBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <Grid Grid.Column="1">
                        <TextBox x:Name="SearchBox"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Foreground="{StaticResource OrionTextBrush}"
                                 CaretBrush="{StaticResource OrionAccentBrush}"
                                 VerticalContentAlignment="Center"
                                 ToolTip="Search by app name, publisher, or description" />
                        <TextBlock Text="Apps, publishers, descriptions"
                                   IsHitTestVisible="False"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource OrionSubtleTextBrush}">
                            <TextBlock.Style>
                                <Style TargetType="{x:Type TextBlock}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SearchText}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                    <Button Grid.Column="2"
                            Content="Clear"
                            Command="{Binding ClearSearchCommand}"
                            Style="{StaticResource QuietButtonStyle}"
                            Padding="8,4"
                            Margin="8,0,0,0"
                            ToolTip="Clear search" />
                </Grid>
            </Grid>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="210" />
                <ColumnDefinition Width="1.25*" />
                <ColumnDefinition Width="0.8*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="14" Margin="0,0,18,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="EXPLORE" FontSize="11" FontWeight="Bold" Foreground="{StaticResource OrionSubtleTextBrush}" Margin="12,8,0,12" />
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="12,0,0,10">
                        <TextBlock Text="Categories" FontSize="16" FontWeight="SemiBold" />
                    </StackPanel>
                    <ListBox Grid.Row="2"
                             ItemsSource="{Binding Categories}"
                             SelectedItem="{Binding SelectedCategory}"
                             Background="Transparent"
                             BorderThickness="0"
                             ItemContainerStyle="{StaticResource CategoryItemStyle}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" FontSize="13" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Border Grid.Row="3" Background="{StaticResource OrionSurfaceRaisedBrush}" CornerRadius="12" Padding="12" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="BUILT FOR WINDOWS" FontSize="10" FontWeight="Bold" Foreground="{StaticResource OrionAccentBrush}" />
                            <TextBlock Text="Browse transparent app metadata and community sources."
                                       TextWrapping="Wrap"
                                       FontSize="12"
                                       Foreground="{StaticResource OrionSubtleTextBrush}"
                                       Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Grid Grid.Column="1" Margin="0,0,18,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,2,0,16">
                    <TextBlock Text="Discover apps" FontSize="27" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding AppCatalogCount}" Foreground="{StaticResource OrionSubtleTextBrush}" FontSize="13" Margin="0,4,0,0" />
                </StackPanel>

                <Border Grid.Row="1" Style="{StaticResource CardStyle}" Background="{StaticResource OrionHeroBrush}" Padding="18" Margin="0,0,0,18">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="GOOD SOFTWARE, WITHOUT THE GUESSWORK" FontSize="10" FontWeight="Bold" Foreground="{StaticResource OrionAccentBrush}" />
                            <TextBlock Text="Find your next favorite." FontSize="22" FontWeight="SemiBold" Margin="0,7,0,0" />
                            <TextBlock Text="Explore useful apps, clear details, and source information in one place."
                                       TextWrapping="Wrap"
                                       FontSize="12"
                                       Foreground="{StaticResource OrionSubtleTextBrush}"
                                       Margin="0,5,12,0" />
                        </StackPanel>
                        <Border Grid.Column="1" Width="58" Height="58" CornerRadius="18" Background="{StaticResource OrionAccentSoftBrush}" VerticalAlignment="Center">
                            <TextBlock Text="O" FontSize="32" FontWeight="Bold" Foreground="{StaticResource OrionAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                </Border>

                <Grid Grid.Row="2" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Featured picks" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="COMMUNITY HIGHLIGHTS" FontSize="10" FontWeight="Bold" Foreground="{StaticResource OrionSubtleTextBrush}" VerticalAlignment="Center" />
                </Grid>

                <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,0,0,18">
                            <ItemsControl ItemsSource="{Binding FeaturedApps}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Width="176" Height="100"
                                                Background="{StaticResource OrionSurfaceBrush}"
                                                BorderBrush="{StaticResource OrionBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="13"
                                                Padding="12"
                                                Margin="0,0,10,0">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Publisher}" Foreground="{StaticResource OrionSubtleTextBrush}" FontSize="11" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Category}" Foreground="{StaticResource OrionAccentBrush}" FontSize="11" Margin="0,10,0,0" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Browse all" FontSize="17" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="1" Text="{Binding StoreSummary}" Foreground="{StaticResource OrionSubtleTextBrush}" FontSize="12" VerticalAlignment="Center" />
                        </Grid>

                        <Grid>
                            <ListBox ItemsSource="{Binding VisibleCatalog}"
                                     SelectedItem="{Binding SelectedApp}"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     ItemContainerStyle="{StaticResource CatalogItemStyle}"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="2" />
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="42" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Border Width="36" Height="36" CornerRadius="11" Background="{StaticResource OrionAccentSoftBrush}">
                                                    <TextBlock Text="{Binding Monogram}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource OrionAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                                                    <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Publisher}" FontSize="11" Foreground="{StaticResource OrionSubtleTextBrush}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="{Binding RatingDisplay}"
                                                           FontSize="10"
                                                           Foreground="{StaticResource OrionAccentBrush}"
                                                           VerticalAlignment="Top"
                                                           Margin="4,2,0,0" />
                                            </Grid>
                                            <TextBlock Text="{Binding Description}"
                                                       FontSize="11"
                                                       Foreground="{StaticResource OrionSubtleTextBrush}"
                                                       TextWrapping="Wrap"
                                                       MaxHeight="34"
                                                       Margin="0,10,0,8" />
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Category}" FontSize="10" Foreground="{StaticResource OrionAccentBrush}" />
                                                <TextBlock Text="  |  " FontSize="10" Foreground="{StaticResource OrionSubtleTextBrush}" />
                                                <TextBlock Text="{Binding InstallType}" FontSize="10" Foreground="{StaticResource OrionSubtleTextBrush}" />
                                                <TextBlock Text="  |  " FontSize="10" Foreground="{StaticResource OrionSubtleTextBrush}" />
                                                <TextBlock Text="{Binding FileSizeDisplay}" FontSize="10" Foreground="{StaticResource OrionSubtleTextBrush}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="18">
                                <StackPanel.Style>
                                    <Style TargetType="{x:Type StackPanel}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasCatalogResults}" Value="False">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Text="No apps found" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                <TextBlock Text="Try a different search or category."
                                           Foreground="{StaticResource OrionSubtleTextBrush}"
                                           FontSize="12"
                                           Margin="0,5,0,0"
                                           HorizontalAlignment="Center" />
                                <Button Content="Clear search"
                                        Command="{Binding ClearSearchCommand}"
                                        Style="{StaticResource QuietButtonStyle}"
                                        Margin="0,12,0,0"
                                        HorizontalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="20">
                <Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <StackPanel.Style>
                                <Style TargetType="{x:Type StackPanel}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasSelectedApp}" Value="False">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <Border Width="64" Height="64" CornerRadius="18" Background="{StaticResource OrionAccentSoftBrush}" HorizontalAlignment="Center" Margin="0,32,0,16">
                                <TextBlock Text="?" FontSize="30" Foreground="{StaticResource OrionAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="Select an app" FontSize="19" FontWeight="SemiBold" HorizontalAlignment="Center" />
                            <TextBlock Text="Choose an app from the catalog to see its version, publisher, source, and package details."
                                       TextWrapping="Wrap"
                                       TextAlignment="Center"
                                       Foreground="{StaticResource OrionSubtleTextBrush}"
                                       FontSize="12"
                                       Margin="0,8,0,0" />
                        </StackPanel>
                    </ScrollViewer>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <StackPanel.Style>
                                <Style TargetType="{x:Type StackPanel}">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasSelectedApp}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="APP DETAILS" FontSize="10" FontWeight="Bold" Foreground="{StaticResource OrionSubtleTextBrush}" />
                            <Border Width="72" Height="72" CornerRadius="20" Background="{StaticResource OrionAccentSoftBrush}" HorizontalAlignment="Left" Margin="0,16,0,16">
                                <TextBlock Text="{Binding SelectedApp.Monogram}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource OrionAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="{Binding SelectedApp.Name}" FontSize="25" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding SelectedApp.Publisher}" Foreground="{StaticResource OrionSubtleTextBrush}" FontSize="13" Margin="0,5,0,0" />

                            <WrapPanel Margin="0,16,0,0">
                                <Border Background="{StaticResource OrionSurfaceRaisedBrush}" CornerRadius="8" Padding="9,5" Margin="0,0,7,7">
                                    <TextBlock Text="{Binding SelectedApp.Category}" FontSize="11" Foreground="{StaticResource OrionAccentBrush}" />
                                </Border>
                                <Border Background="{StaticResource OrionSurfaceRaisedBrush}" CornerRadius="8" Padding="9,5" Margin="0,0,7,7">
                                    <TextBlock Text="{Binding SelectedApp.RatingDisplay}" FontSize="11" />
                                </Border>
                                <Border Background="{StaticResource OrionSurfaceRaisedBrush}" CornerRadius="8" Padding="9,5" Margin="0,0,7,7">
                                    <TextBlock Text="{Binding SelectedApp.InstallType}" FontSize="11" />
                                </Border>
                            </WrapPanel>

                            <Border Height="1" Background="{StaticResource OrionBorderBrush}" Margin="0,14,0,14" />
                            <TextBlock Text="About this app" FontSize="15" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding SelectedApp.Description}"
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource OrionSubtleTextBrush}"
                                       FontSize="12"
                                       LineHeight="19"
                                       Margin="0,7,0,0" />

                            <TextBlock Text="PACKAGE INFORMATION" FontSize="10" FontWeight="Bold" Foreground="{StaticResource OrionSubtleTextBrush}" Margin="0,22,0,10" />
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Version" Foreground="{StaticResource OrionSubtleTextBrush}" FontSize="12" />
                                <TextBlock Grid.Column="1" Text="{Binding SelectedApp.Version}" FontSize="12" />
                            </Grid>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Package size" Foreground="{StaticResource OrionSubtleTextBrush}" FontSize="12" />
                                <TextBlock Grid.Column="1" Text="{Binding SelectedApp.FileSizeDisplay}" FontSize="12" />
                            </Grid>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Package ID" Foreground="{StaticResource OrionSubtleTextBrush}" FontSize="12" />
                                <TextBlock Grid.Column="1" Text="{Binding SelectedApp.PackageId}" FontSize="11" TextTrimming="CharacterEllipsis" Margin="8,0,0,0" />
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Source" Foreground="{StaticResource OrionSubtleTextBrush}" FontSize="12" />
                                <TextBlock Grid.Column="1" Text="{Binding SelectedApp.Source}" FontSize="12" />
                            </Grid>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="License" Foreground="{StaticResource OrionSubtleTextBrush}" FontSize="12" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <TextBlock Text="{Binding SelectedApp.License}" FontSize="12" />
                                    <TextBlock Margin="8,0,0,0"
                                               Visibility="{Binding SelectedApp.HasLicenseUrl, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <Hyperlink NavigateUri="{Binding SelectedApp.LicenseUrl}"
                                                   RequestNavigate="LicenseLink_RequestNavigate"
                                                   Foreground="{StaticResource OrionAccentBrush}">View license</Hyperlink>
                                    </TextBlock>
                                </StackPanel>
                            </Grid>

                            <Border Background="{StaticResource OrionSurfaceRaisedBrush}" CornerRadius="11" Padding="12" Margin="0,22,0,0">
                                <StackPanel>
                                    <TextBlock Text="Install or update" FontSize="13" FontWeight="SemiBold" />
                                    <TextBlock Text="Winget opens in a separate window. Review its package details and approve any installer prompts."
                                               TextWrapping="Wrap"
                                               Foreground="{StaticResource OrionSubtleTextBrush}"
                                               FontSize="11"
                                               Margin="0,5,0,10" />
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="Install"
                                                Click="InstallSelected_Click"
                                                IsEnabled="{Binding CanStartPackageAction}"
                                                Background="{StaticResource OrionAccentBrush}"
                                                Foreground="{StaticResource OrionWindowBrush}"
                                                BorderThickness="0"
                                                Padding="16,8"
                                                FontWeight="SemiBold"
                                                Cursor="Hand" />
                                        <Button Content="Update"
                                                Click="UpgradeSelected_Click"
                                                IsEnabled="{Binding CanStartPackageAction}"
                                                Margin="8,0,0,0"
                                                Padding="16,8"
                                                Cursor="Hand" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding PackageOperationStatus}"
                                               TextWrapping="Wrap"
                                               Foreground="{StaticResource OrionSubtleTextBrush}"
                                               FontSize="10"
                                               Margin="0,10,0,0" />
                                </StackPanel>
                                <Border.Style>
                                    <Style TargetType="{x:Type Border}" BasedOn="{StaticResource CardStyle}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedApp.CanManageWithWinget}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>
                            <Border Background="{StaticResource OrionSurfaceRaisedBrush}" CornerRadius="11" Padding="12" Margin="0,22,0,0">
                                <StackPanel>
                                    <TextBlock Text="Catalog preview only" FontSize="12" FontWeight="SemiBold" />
                                    <TextBlock Text="Installation and updates are not configured for this listing."
                                               TextWrapping="Wrap"
                                               Foreground="{StaticResource OrionSubtleTextBrush}"
                                               FontSize="11"
                                               Margin="0,5,0,0" />
                                </StackPanel>
                                <Border.Style>
                                    <Style TargetType="{x:Type Border}" BasedOn="{StaticResource CardStyle}">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedApp.CanManageWithWinget}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
